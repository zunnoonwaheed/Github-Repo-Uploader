# GitHub OAuth App Credentials (OPTIONAL)
# The app comes with default credentials, but you can create your own
# Create an OAuth App at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/auth/github/callback

# GITHUB_CLIENT_ID=your_github_client_id_here
# GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Session secret (optional, will auto-generate if not provided)
# SESSION_SECRET=your_random_session_secret_here

# Port to run on (optional, defaults to 3000)
# PORT=3000
